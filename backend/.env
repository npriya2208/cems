# Copy this file to `.env` (or set these as real environment variables) and
# fill in real values. Do NOT commit your actual .env file.

# --- Auth ---
# Long random string used to sign JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CEMS_SECRET_KEY=22b745d49da0d4da0a0e5e8596a6a527b476a69922612ae43728d3fc1fddfcf9

# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services > Credentials).
# Must match the client ID configured in frontend/index.html and google-auth.js.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Email (required for real OTP delivery during registration) ---
# Without these three set, /api/auth/register/request-otp will fail with a
# clear "email delivery not configured" error instead of pretending to work.
#
# Quick setup with Gmail:
#   1. Turn on 2-Step Verification on the Google account you'll send from:
#      https://myaccount.google.com/security
#   2. Create an "App Password": https://myaccount.google.com/apppasswords
#   3. Use that 16-character app password below (NOT your normal Gmail password).
CEMS_SMTP_HOST=smtp.gmail.com
CEMS_SMTP_PORT=465
CEMS_SMTP_USER=cems.webs@gmail.com
CEMS_SMTP_PASSWORD=ozkikkwuwancmywz

# Set to 1 ONLY for local development if you don't want to configure real
# email yet — OTPs will be printed to the server console/log instead of
# being emailed. Leave unset (or 0) for anything resembling production.
CEMS_ALLOW_CONSOLE_OTP=0
